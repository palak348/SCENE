# Copy this file to ".env" and fill in your keys.

# --- LLM: Gemini (free key from https://aistudio.google.com) ---
# If GEMINI_API_KEY is set as an OS environment variable, you can leave it out here.
GEMINI_API_KEY=
# Best model first, then free fallbacks (auto-rotation on quota limits):
GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.0-flash

# --- Silk TTS (Rumik) — paste your key to turn ON the real voice ---
# Without a key, the app uses the browser's built-in voice (fallback).
SILK_API_KEY=
SILK_MODEL=mulberry
# mulberry only: natural-language voice persona
SILK_DESCRIPTION=a warm friendly 20s indian woman, conversational pacing, casual register, sales_pitch_voice
